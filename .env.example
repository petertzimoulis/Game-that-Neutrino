# Use a long random password with letters/numbers (so it is also URL-safe).
POSTGRES_PASSWORD=
# For a local Docker preview, use http://localhost.
# For public hosting, set your DNS name here; Caddy provisions HTTPS automatically.
SITE_ADDRESS=http://localhost
WEB_WORKERS=4
WEB_THREADS=8
DB_POOL_SIZE=8
# Optional HTTPS media CDN origin, e.g. https://media.your-domain.example
# Upload the videos/ directory with its existing folder names and paths.
VIDEO_BASE_URL=
